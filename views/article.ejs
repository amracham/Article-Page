<% pageTitle = article.title -%>
<%- include('partials/header') %>

<article class="article-full">
  <a class="back-link" href="/">&larr; Back to articles</a>
  <% if (article.thumbnail) { %>
    <img class="article-thumb" src="<%= article.thumbnail %>" alt="<%= article.title %>" />
  <% } %>
  <% if (article.tag) { %><span class="tag"><%= article.tag %></span><% } %>
  <h1><%= article.title %></h1>
  <p class="date"><%= formatDate(article.createdAt) %></p>
  <div class="article-content">
    <% article.content.split(/\n\s*\n/).forEach(function(paragraph) { %>
      <p><%= paragraph %></p>
    <% }); %>
  </div>
  <% if (article.gallery && article.gallery.length) { %>
    <div class="gallery">
      <% article.gallery.forEach(function(photo) { %>
        <figure class="gallery-item">
          <img src="<%= photo.src %>" alt="<%= photo.caption %>" loading="lazy" />
          <figcaption><%= photo.caption %></figcaption>
        </figure>
      <% }); %>
    </div>
  <% } %>
</article>

<%- include('partials/footer') %>
